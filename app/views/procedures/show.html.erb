<div class="container col-8">
  <% unless @procedure.name == "Untitled" %>
    <h1><%= @procedure.name %></h1>
  <% end %>
  <br>

  <div id="messages">
    <% @procedure.messages.each do |message| %>
      <% if message.role == "user" %>
        <div class="d-flex justify-content-end mb-2">
          <div class="bg-white px-3 pb-0 pt-3 rounded-pill">
            <%= raw(render_markdown(message.content)) %>
          </div>
        </div>
      <% elsif message.role == "assistant" %>
        <div class="d-flex justify-content-start mb-5">
          <div class="px-3 pb-0 pt-3">
            <%= raw(render_markdown(message.content)) %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="row justify-content-center">
    <div>
      <%= simple_form_for [@procedure, @message] do |f| %>
        <%= f.input :content, label: "Pose tes questions sur ta démarche", required: true, placeholder: "Je voudrais faire une carte d'idendité" %>
        <%= f.button :submit, "Let's go", class: 'btn btn-primary' %>
      <% end %>
    </div>
  </div>
</div>
