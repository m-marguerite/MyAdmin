<div class="container">
  <div class="row justify-content-center">
    <div class="col-8">
      <%= simple_form_for :search, url: create_procedure_path, method: :post do |f| %>
        <div class="search-form-control form-group mt-4">
          <input class="form-control string required" type="text" name="question" id="question" placeholder="Ask anything to your procedure assistant..."/>
            <%= button_to create_procedure_path, class: "btn btn-flat" do %>
              <i class="fas fa-search"></i> Send
            <% end %>
          </div>
        </div>
      <% end %>

    <% if !@procedures.empty? %>
    <ul class="mt-4">
      <% @procedures.each do |procedure| %>
        <li>
          <%= link_to procedure.name, procedure_path(procedure) %>
        </li>
      <% end %>
    </ul>
    <% else %>
      <h2>Pas de procédure en cours.</h2>
    <% end %>
    </div>
  </div>
</div>
