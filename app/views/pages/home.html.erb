
<div class="home-container">

  <div class="home-card">

    <div class="logo-circle">
      <%= image_tag "logo_myadmin.png", alt: "logo"%>
    </div>

    <h1><strong>MyAdmin</strong></h1>

    <p class="subtitle">
      Votre assistant administratif
    </p>

    <div class="card-grid">
      <div class="g-col-4">

          <div class="card-trip greentea">
            <%= image_tag "icone-ia.png", alt:"logo ia", class:"logo "%>
            <div class="card-trip-infos">
              <div>
                <h2>Assistant IA</h2>
                <p>Posez vos questions, on vous guide pas à pas.</p>
              </div>
            </div>
          </div>

      </div>
      <div class="g-col-4">
          <div class="card-trip ligthbronze">
            <%= image_tag "icone-checklist.png", alt:"logo checklist", class:"logo"%>
            <div class="card-trip-infos">
              <div>
                <h2>Checklist</h2>
                <p>Cochez chaque étape, n'oubliez plus rien.</p>
              </div>
            </div>
          </div>

      </div>
      <div class="g-col-4">
          <div class="card-trip jungleteal">
            <%= image_tag "icone-document.png", alt:"logo document", class: "logo"%>
            <div class="card-trip-infos">
              <div>                <h2>Documents</h2>
                <p>Ayez votre liste de documents à portée de main.
              </div>
            </div>
          </div>
      </div>
    </div>

    <% if user_signed_in? %>
      <%= button_to "Commencer une démarche", procedures_path, class:"button-round" %>
    <% else %>
      <%= button_to "Connectez-vous!", new_user_session_path, class:"button-round" %>
    <% end %>

  </div>

</div>
