
<div class="home-container">

  <div class="home-card">

    <div class="logo-circle">
      <%= image_tag "logo_myadmin.png", alt: "logo"%>
    </div>

    <h1>MyAdmin</h1>

    <p class="subtitle">
      Votre assistant IA administratif
    </p>

    <p class="description1">
     Vos démarches administratives, enfin simples.
     Avec MyAdmin, vous êtes guidé·e pas à pas,
     de la première question jusqu’au dernier document.
    </p>

    <p class="description2">
      L’assistant IA vous explique chaque étape avec des mots clairs.
      La checklist vous montre ce qu’il reste à faire. Vos documents sont rangés au même endroit.
      Vous n’oubliez plus rien.
    </p>

    <div class="card-grid">
      <div class="g-col-4">
        <div class="features">
          <div class="card-trip ">
            <%= image_tag "icone-ia.png", alt:"logo ia", class:"logo"%>
            <div class="card-trip-infos">
              <div>
                <h2>Title here</h2>
                <p>Short description here!</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="g-col-4">
        <div class="features">
          <div class="card-trip">
            <%= image_tag "icone-checklist.png", alt:"logo checklist", class:"logo"%>
            <div class="card-trip-infos">
              <div>
                <h2>Title here</h2>
                <p>Short description here!</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="g-col-4">
        <div class="features">
          <div class="card-trip">
            <%= image_tag "icone-document.png", alt:"logo document", class: "logo"%>
            <div class="card-trip-infos">
              <div>
                <h2>Title here</h2>
                <p>Short description here!</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%= button_to "Commencer une démarche", procedures_path, class:"start-button" %>

  </div>

</div>
