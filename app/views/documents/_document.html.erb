<%= form_with url: toggle_checklist_document_path(document.checklist, document), method: :patch, class: "form-check checklist-item", id: "document_#{document.id}" do |f| %>
  <label class="form-check-label">
    <%= f.check_box :checked, checked: document.checked, class: "form-check-input", onchange: "this.form.requestSubmit()" %>
    <%= document.name %>
  </label>
<% end %>
